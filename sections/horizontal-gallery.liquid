<section class="hg" data-gsap-horizontal>
  <div class="hg__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="hg__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <ul class="hg__track" data-gsap-track role="list">
    {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
      <li class="hg__item">
        <a href="{{ product.url }}" class="hg__link">
          <div class="hg__media">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 750px) 30vw, 70vw', alt: product.featured_image.alt
              }}
            {%- endif -%}
          </div>
          <p class="hg__title">{{ product.title }}</p>
          <p class="hg__price">{{ product.price | money }}</p>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .hg {
    padding: 4rem 0;
  }
  .hg__heading {
    margin: 0 0 2rem;
  }
  .hg__track {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0 2rem;
    /* 默认（手机端 / 减少动态效果）：原生横向滑动 */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .hg__item {
    flex: 0 0 70vw;
    scroll-snap-align: start;
  }
  .hg__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .hg__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.05);
  }
  .hg__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hg__title {
    margin: 1rem 0 0.25rem;
  }
  .hg__price {
    margin: 0;
    opacity: 0.7;
  }

  /* 只有 GSAP 接管后才启用（桌面端） */
  .hg.is-gsap {
    padding: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .hg.is-gsap .hg__track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    padding: 0 5vw;
  }
  .hg.is-gsap .hg__item {
    flex: 0 0 28vw;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "横向滚动画廊",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "新品推荐" },
    { "type": "collection", "id": "collection", "label": "集合" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "商品数量"
    }
  ],
  "presets": [{ "name": "横向滚动画廊" }]
}

{% endschema %}