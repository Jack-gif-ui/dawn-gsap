{{ 'horizontal-gallery-styles.css' | asset_url | stylesheet_tag }}
<section class="hg" data-gsap-horizontal style="--hg-card-width: {{ section.settings.card_width }}vw;">
  <div class="hg__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="hg__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <ul class="hg__track" data-gsap-track role="list">
    {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
      <li class="hg__item">
        <a href="{{ product.url }}" class="hg__link">
          <div class="hg__media">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450, 700, 900',
                  sizes: '(min-width: 750px) 30vw, 70vw',
                  alt: product.featured_image.alt
              }}
            {%- endif -%}
          </div>
          <p class="hg__title">{{ product.title }}</p>
          <p class="hg__price">{{ product.price | money }}</p>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>



{% schema %}
{
  "name": "横向滚动画廊",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "新品推荐" },
    { "type": "collection", "id": "collection", "label": "集合" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "商品数量"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 15,
      "max": 40,
      "step": 1,
      "unit": "vw",
      "default": 20,
      "label": "桌面端卡片宽度"
    }
  ],
  "presets": [{ "name": "横向滚动画廊" }]
}
{% endschema %}
