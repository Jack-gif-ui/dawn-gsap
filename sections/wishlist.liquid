{{ 'card-badges.css' | asset_url | stylesheet_tag }}

<wishlist-page
  class="wp"
  data-currency="{{ cart.currency.iso_code }}"
  data-stock="{{ section.settings.badge_stock_text | escape }}"
  data-sale="{{ section.settings.badge_sale_text | escape }}"
  data-soldout="{{ section.settings.badge_soldout_text | escape }}"
  style="
    --cb-color: {{ section.settings.badge_color }};
    --cb-scale: {{ section.settings.badge_scale | divided_by: 100.0 }};
    --wp-pt: {{ section.settings.padding_top }}px;
    --wp-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <header class="wp__head">
      <h1 class="wp__title">{{ section.settings.heading | escape }}</h1>
      <p class="wp__count" data-wp-count aria-live="polite" hidden></p>
    </header>

    <p class="wp__loading" data-wp-loading>{{ section.settings.loading_text | escape }}</p>

    <ul class="wp__grid" data-wp-grid role="list"></ul>

    <div class="wp__empty" data-wp-empty hidden>
      <p class="wp__empty-text">{{ section.settings.empty_text | escape }}</p>
      <a class="wp__btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{- section.settings.button_label | escape -}}
      </a>
    </div>
  </div>
</wishlist-page>

<script src="{{ 'wishlist-page.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  wishlist-page {
    display: block;
  }
  .wp {
    padding: var(--wp-pt, 40px) 0 var(--wp-pb, 80px);
  }
  .wp__head {
    margin-bottom: 3.2rem;
    text-align: center;
  }
  .wp__title {
    margin: 0;
    font-size: clamp(2.8rem, 4vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .wp__count {
    margin: 1rem 0 0;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.6rem;
  }
  .wp__loading {
    padding: 4rem 0;
    color: rgba(var(--color-foreground), 0.6);
    text-align: center;
  }
  .wp__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .wp__card {
    min-width: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .wp__card.is-leaving {
    opacity: 0;
    transform: scale(0.96);
  }
  .wp__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f5f5f5;
  }
  .wp__media-link {
    position: absolute;
    inset: 0;
    display: block;
  }
  .wp__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wp__remove {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 6;
    display: grid;
    place-items: center;
    width: 3.8rem;
    height: 3.8rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(var(--color-foreground), 0.8);
    cursor: pointer;
  }
  .wp__remove svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .wp__remove:hover {
    color: rgb(var(--color-foreground));
  }
  .wp__remove:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: -0.4rem;
    border-radius: 50%;
  }
  .wp__info {
    padding-top: 1.4rem;
  }
  .wp__name {
    display: -webkit-box;
    overflow: hidden;
    color: inherit;
    font-size: 1.5rem;
    line-height: 1.35;
    text-decoration: none;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .wp__name:hover {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  .wp__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0.8rem 0 0;
    font-size: 1.7rem;
  }
  .wp__now {
    color: #2b6ea9;
    font-weight: 800;
  }
  .wp__was {
    color: rgba(var(--color-foreground), 0.65);
    text-decoration: line-through;
  }
  .wp__empty {
    padding: 4rem 0;
    text-align: center;
  }
  .wp__empty-text {
    margin: 0 0 2.4rem;
    font-size: 1.8rem;
  }
  .wp__btn {
    display: inline-block;
    padding: 1.4rem 3.2rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }
  @media (min-width: 750px) {
    .wp__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.2rem 2rem;
    }
  }
  @media (min-width: 990px) {
    .wp__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wp__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "心愿单",
  "settings": [
    { "type": "header", "content": "文字" },
    { "type": "text", "id": "heading", "label": "页面标题", "default": "My wishlist" },
    { "type": "text", "id": "loading_text", "label": "加载中的提示", "default": "Loading…" },
    { "type": "text", "id": "empty_text", "label": "心愿单为空时的提示", "default": "Your wishlist is empty." },
    { "type": "text", "id": "button_label", "label": "空状态按钮文字", "default": "Continue shopping" },
    {
      "type": "url",
      "id": "button_link",
      "label": "空状态按钮链接",
      "info": "不填则跳转到全部商品页"
    },

    { "type": "header", "content": "商品徽章" },
    { "type": "text", "id": "badge_stock_text", "label": "有货徽章文字", "default": "In stock", "info": "留空则不显示" },
    {
      "type": "text",
      "id": "badge_sale_text",
      "label": "折扣徽章文字",
      "default": "{percent}% OFF",
      "info": "{percent} 会自动换成折扣百分比"
    },
    { "type": "text", "id": "badge_soldout_text", "label": "售罄徽章文字", "default": "Sold out" },
    { "type": "color", "id": "badge_color", "label": "徽章主色", "default": "#2b6ea9" },
    {
      "type": "range",
      "id": "badge_scale",
      "min": 70,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "徽章大小",
      "default": 70
    },

    { "type": "header", "content": "间距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 80
    }
  ],
  "presets": [{ "name": "心愿单" }]
}
{% endschema %}