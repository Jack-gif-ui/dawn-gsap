{{ 'bento-flip-gallery-styles.css' | asset_url | stylesheet_tag }}
<section class="bf" data-gsap-bento-flip>
  <div class="bf__grid" data-gsap-bento-grid>
    {%- for block in section.blocks -%}
      <div class="bf__item bf__item--{{ forloop.index }}" data-gsap-bento-item {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          {{
            block.settings.image
            | image_url: width: 1000
            | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 50vw', class: 'bf__img'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'bf__img placeholder-svg' }}
        {%- endif -%}
      </div>
    {%- endfor -%}

    <div class="bf__item bf__item--center" data-gsap-bento-item data-gsap-bento-center>
      {%- if section.settings.center_image -%}
        {{
          section.settings.center_image
          | image_url: width: 2400
          | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 2400', sizes: '100vw', class: 'bf__img'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'bf__img placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>



{% schema %}
{
  "name": "Bento Flip 画廊",
  "tag": "section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "中间图片（滚动时放大到全屏）"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "周围图片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Flip 画廊",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
