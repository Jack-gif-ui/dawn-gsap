{{ 'blog-carousel-styles.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign blog = section.settings.blog
  assign limit = section.settings.post_limit
  assign cols = section.settings.columns | plus: 0
  assign cols_tablet = cols | at_most: 2
  assign has_articles = false
  if blog != blank and blog.articles.size > 0
    assign has_articles = true
  endif
-%}

<blog-carousel
  class="bc"
  {% if section.settings.loop %}
    data-loop
  {% endif %}
  style="
    --bc-cols: {{ cols }};
    --bc-cols-t: {{ cols_tablet }};
    --bc-ratio: {{ section.settings.image_ratio }};
    --bc-radius: {{ section.settings.card_radius }}px;
    --bc-tag: {{ section.settings.tag_color }};
    --bc-pt: {{ section.settings.padding_top }}px;
    --bc-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="bc__wrap page-width">
    <div class="bc__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="bc__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.line_style != 'none' -%}
        <div class="bc__progress bc__progress--{{ section.settings.line_style }}" aria-hidden="true">
          <span class="bc__progress-fill" data-bc-fill></span>
        </div>
      {%- endif -%}

      <div class="bc__nav">
        <button type="button" class="bc__arrow bc__arrow--prev" data-bc-prev aria-label="Previous articles">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 12H4M10 6l-6 6 6 6"/>
          </svg>
        </button>
        <button type="button" class="bc__arrow bc__arrow--next" data-bc-next aria-label="Next articles">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 12h16M14 6l6 6-6 6"/>
          </svg>
        </button>
      </div>

      <div class="bc__dots">
        <button type="button" class="bc__dot is-active" data-bc-pill="prev" aria-label="Previous article"></button>
        <button type="button" class="bc__dot" data-bc-pill="next" aria-label="Next article"></button>
      </div>
    </div>

    <ul class="bc__track" data-bc-track role="list">
      {%- if has_articles -%}
        {%- for article in blog.articles limit: limit -%}
          {%- liquid
            assign words = article.content | strip_html | split: ' ' | size
            assign minutes = words | divided_by: 200.0 | ceil | at_least: 1
            assign img_alt = article.image.alt | default: article.title
          -%}
          <li class="bc__card">
            <article class="bc__article">
              <div class="bc__media">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 1000',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 82vw',
                      alt: img_alt,
                      class: 'bc__img'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'bc__img placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="bc__body">
                {%- if section.settings.show_tag -%}
                  {%- if article.tags.size > 0 -%}
                    <p class="bc__tag">{{ article.tags.first | escape }}</p>
                  {%- else -%}
                    <p class="bc__tag bc__tag--empty" aria-hidden="true">&nbsp;</p>
                  {%- endif -%}
                {%- endif -%}

                <h3 class="bc__title">
                  <a href="{{ article.url }}" class="bc__link">{{ article.title | escape }}</a>
                </h3>

                {%- if section.settings.show_excerpt -%}
                  <p class="bc__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
                {%- endif -%}

                <p class="bc__meta">
                  {{ article.published_at | time_tag: '%b %d, %Y' }}
                  {%- if section.settings.show_read_time -%}
                    <span class="bc__sep" aria-hidden="true"></span>
                    <span>{{ minutes }} min read</span>
                  {%- endif -%}
                </p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="bc__card">
            <article class="bc__article">
              <div class="bc__media">{{ 'image' | placeholder_svg_tag: 'bc__img placeholder-svg' }}</div>
              <div class="bc__body">
                <h3 class="bc__title">Blog post title</h3>
                <p class="bc__meta">Select a blog in section settings</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</blog-carousel>

<script src="{{ 'blog-carousel.js' | asset_url }}" defer="defer"></script>



{% schema %}
{
  "name": "Blog 轮播",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Blog & Articles" },
    {
      "type": "blog",
      "id": "blog",
      "label": "博客",
      "info": "文章内容在后台「博客文章」里编辑"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "最多显示文章数",
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "桌面端每屏显示",
      "default": "3",
      "options": [
        { "value": "2", "label": "2 篇" },
        { "value": "3", "label": "3 篇" },
        { "value": "4", "label": "4 篇" }
      ]
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "标题右侧细线（桌面端）",
      "default": "line",
      "options": [
        { "value": "line", "label": "装饰细线" },
        { "value": "progress", "label": "跟随滚动的进度线" },
        { "value": "none", "label": "不显示" }
      ]
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "循环滑动",
      "info": "桌面端：到头后再点箭头回到另一端；移动端：滑到最右侧再向左滑，回到第一篇",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "封面图比例",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "卡片圆角",
      "default": 20
    },
    { "type": "header", "content": "卡片内容" },
    { "type": "checkbox", "id": "show_tag", "label": "显示标签（文章第一个标签）", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "显示摘要", "default": false },
    { "type": "checkbox", "id": "show_read_time", "label": "显示阅读时长", "default": true },
    { "type": "color", "id": "tag_color", "label": "标签颜色", "default": "#2b6cb0" },
    { "type": "header", "content": "间距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 36
    }
  ],
  "presets": [{ "name": "Blog 轮播" }]
}
{% endschema %}
