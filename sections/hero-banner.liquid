{%- liquid
  assign desktop = section.settings.desktop_image
  assign mobile = section.settings.mobile_image
  if desktop == blank
    assign desktop = mobile
  endif
  if mobile == blank
    assign mobile = desktop
  endif
  if section.index == 1
    assign img_loading = 'eager'
    assign img_priority = 'high'
  else
    assign img_loading = 'lazy'
    assign img_priority = 'auto'
  endif
-%}

<section
  class="hero hero--{{ section.settings.height_mode }}"
  style="
    --hero-ratio-d: {{ section.settings.desktop_ratio }};
    --hero-ratio-m: {{ section.settings.mobile_ratio }};
    --hero-min-h: {{ section.settings.min_height }}px;
    --hero-pos-d: 50% {{ section.settings.desktop_focus_y }}%;
    --hero-pos-m: {{ section.settings.mobile_focus_x }}% 50%;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-scale: {{ section.settings.heading_scale | divided_by: 100.0 }};
    --hero-text: {{ section.settings.text_color }};
    --hero-btn-bg: {{ section.settings.button_bg }};
    --hero-btn-text: {{ section.settings.button_text }};
  "
>
  <div class="hero__media">
    {%- if desktop != blank -%}
      <picture>
        <source
          media="(min-width: 750px)"
          srcset="
            {{ desktop | image_url: width: 1200 }} 1200w,
            {{ desktop | image_url: width: 1800 }} 1800w,
            {{ desktop | image_url: width: 2400 }} 2400w
          "
          sizes="100vw"
          width="{{ desktop.width }}"
          height="{{ desktop.height }}"
        >
        <img
          src="{{ mobile | image_url: width: 900 }}"
          srcset="
            {{ mobile | image_url: width: 600 }} 600w,
            {{ mobile | image_url: width: 900 }} 900w,
            {{ mobile | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
          width="{{ mobile.width }}"
          height="{{ mobile.height }}"
          alt="{{ mobile.alt | escape }}"
          loading="{{ img_loading }}"
          fetchpriority="{{ img_priority }}"
          decoding="async"
        >
      </picture>
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="hero__content hero__content--{{ section.settings.content_valign }}">
    <div class="hero__inner{% if section.settings.uppercase %} hero__inner--upper{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="hero__heading">
          {{- section.settings.heading | escape -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="hero__button"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% endif %}
        >
          <span class="hero__glow" aria-hidden="true"></span>
          <span>{{ section.settings.button_label | escape }}</span>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 12h16M14 6l6 6-6 6"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="hero__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    overflow: hidden;
    color: var(--hero-text, #fff);
    background: #111;
  }
  .hero__media {
    position: relative;
  }
  .hero__media picture,
  .hero__media img,
  .hero__placeholder {
    display: block;
    width: 100%;
  }
  .hero__media img {
    height: auto;
  }
  .hero__placeholder {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  /* 顶部渐变保证透明 header 的白字可读，再叠一层整体遮罩 */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0, rgba(0, 0, 0, 0) 28%),
      rgba(0, 0, 0, var(--hero-overlay, 0));
    pointer-events: none;
  }

  /* 比例模式：容器按宽高比，图片 cover 裁切 */
  .hero--ratio {
    aspect-ratio: var(--hero-ratio-m, 9 / 15.5);
  }
  .hero--ratio .hero__media {
    position: absolute;
    inset: 0;
  }
  .hero--ratio .hero__media picture,
  .hero--ratio .hero__media img,
  .hero--ratio .hero__placeholder {
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-pos-m, 50% 50%);
  }

  .hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    box-sizing: border-box;
    padding: 3rem 2rem;
  }
  .hero__content--center { align-items: center; }
  .hero__content--start { align-items: flex-start; }
  .hero__content--end { align-items: flex-end; }

  /* 透明 header 时，内容区避开 header */
  .header-transparent #MainContent > .shopify-section:first-child .hero__content {
    padding-top: calc(var(--header-height, 0px) + 3rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 120rem;
    text-align: center;
  }
  .hero__inner--upper {
    text-transform: uppercase;
  }

  /* 流体字号：随屏幕宽度平滑缩放 */
  .hero__eyebrow {
    margin: 0;
    padding-left: 0.2em; /* 抵消末尾字距，视觉居中 */
    font-size: clamp(12px, 1.2vw, 18px);
    font-weight: 700;
    letter-spacing: 0.2em;
  }
  .hero__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: calc(clamp(40px, 6vw, 90px) * var(--hero-scale, 1));
    font-weight: 700;
    line-height: 0.9;
    color: inherit;
  }
  .hero__sub {
    margin: 0;
    padding-left: 0.27em;
    font-size: clamp(22px, 6vw, 40px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.27em;
  }
  .hero__note {
    margin: 1rem 0 0;
    font-size: 1.4rem;
    text-transform: none;
  }

  /* 按钮 + 悬停光晕 */
  .hero__button {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 1.5rem 3rem;
    border-radius: 1.5rem;
    background: var(--hero-btn-bg, #298fd1);
    color: var(--hero-btn-text, #fff);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero__button > *:not(.hero__glow) {
    position: relative;
    z-index: 1;
  }
  .hero__button svg {
    transition: transform 0.3s ease;
  }
  .hero__button:hover svg {
    transform: translateX(4px);
  }
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 70%);
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 750px) {
    .hero--ratio {
      aspect-ratio: var(--hero-ratio-d, 16 / 6);
      min-height: var(--hero-min-h, 520px);
    }
    .hero--ratio .hero__media img,
    .hero--ratio .hero__placeholder {
      object-position: var(--hero-pos-d, 50% 50%);
    }
    .hero__button {
      font-size: 1.6rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero 横幅",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "图片" },
    { "type": "image_picker", "id": "desktop_image", "label": "桌面端图片", "info": "建议 2:1 横图，宽 2400px 以上" },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端图片",
      "info": "建议 2:3 竖图，宽 1000px 以上。不选则使用桌面端图片"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "高度模式",
      "default": "ratio",
      "options": [
        { "value": "ratio", "label": "按宽高比（图片 cover 裁切）" },
        { "value": "auto", "label": "跟随图片比例（完整显示原图）" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_ratio",
      "label": "桌面端宽高比",
      "default": "16 / 6",
      "options": [
        { "value": "16 / 6", "label": "16:6（最扁）" },
        { "value": "16 / 7", "label": "16:7" },
        { "value": "16 / 8", "label": "16:8（2:1）" },
        { "value": "16 / 9", "label": "16:9" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "移动端宽高比",
      "default": "9 / 15.5",
      "options": [
        { "value": "9 / 15.5", "label": "9:15.5（接近全屏）" },
        { "value": "9 / 16", "label": "9:16" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" }
      ]
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 360,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "桌面端最小高度",
      "info": "窄屏桌面上避免高度太矮、文字被挤压",
      "default": 520
    },
    {
      "type": "range",
      "id": "desktop_focus_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "桌面图垂直焦点",
      "info": "被裁切时保留图片的哪个高度：0 靠上，100 靠下",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_focus_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "移动图水平焦点",
      "info": "被裁切时保留图片的哪一侧：0 靠左，100 靠右",
      "default": 50
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "图片遮罩深度",
      "default": 20
    },

    { "type": "header", "content": "文字" },
    { "type": "text", "id": "eyebrow", "label": "上方小标题", "default": "Black Friday" },
    { "type": "text", "id": "heading", "label": "主标题", "default": "70% off sitewide" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "主标题标签",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "info": "首页 logo 通常已经是 H1，一般选 H2"
    },
    { "type": "text", "id": "subheading", "label": "副标题", "default": "+Free gifts" },
    { "type": "text", "id": "button_label", "label": "按钮文字", "default": "Shop the sale" },
    { "type": "url", "id": "button_link", "label": "按钮链接" },
    { "type": "text", "id": "note", "label": "底部小字", "default": "*No code needed." },
    { "type": "checkbox", "id": "uppercase", "label": "文字全部大写", "default": true },
    {
      "type": "range",
      "id": "heading_scale",
      "min": 60,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "主标题大小",
      "info": "在流体字号的基础上整体放大或缩小",
      "default": 100
    },
    {
      "type": "select",
      "id": "content_valign",
      "label": "内容垂直位置",
      "default": "center",
      "options": [
        { "value": "start", "label": "靠上" },
        { "value": "center", "label": "居中" },
        { "value": "end", "label": "靠下" }
      ]
    },

    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#ffffff" },
    { "type": "color", "id": "button_bg", "label": "按钮背景", "default": "#298fd1" },
    { "type": "color", "id": "button_text", "label": "按钮文字", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Hero 横幅" }]
}
{% endschema %}