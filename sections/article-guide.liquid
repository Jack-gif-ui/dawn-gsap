{%- liquid
  assign updated = article.updated_at | default: article.published_at
  assign share_url = canonical_url | url_encode
  assign share_title = article.title | url_encode
  assign img_alt = article.image.alt | default: article.title
-%}

<article-guide
  class="ag"
  data-min-headings="{{ section.settings.toc_min }}"
  style="
    --ag-aside-w: {{ section.settings.aside_width }}px;
    --ag-ratio: {{ section.settings.image_ratio }};
    --ag-ratio-m: {% if section.settings.image_ratio == 'auto' %}auto{% else %}3 / 2{% endif %};
    --ag-pt: {{ section.settings.padding_top }}px;
    --ag-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.show_image and article.image -%}
      <div class="ag__hero">
        {{
          article.image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 2000',
            sizes: '(min-width: 1200px) 1200px, 100vw',
            alt: img_alt,
            class: 'ag__hero-img'
        }}
      </div>
    {%- endif -%}

    <div class="ag__layout">
      <div class="ag__main">
        <header class="ag__head">
          <h1 class="ag__title">{{ article.title | escape }}</h1>
          <p class="ag__meta">
            {%- if article.author != blank -%}
              <span>{{ article.author | escape }}</span>
              <span class="ag__dot" aria-hidden="true"></span>
            {%- endif -%}
            <span>Last updated on {{ updated | time_tag: '%b %d, %Y' }}</span>
          </p>
        </header>

        {%- comment -%} 移动端目录：折叠在标题下方 {%- endcomment -%}
        <details class="ag__toc-m" data-ag-toc>
          <summary>{{ section.settings.toc_title | escape }}</summary>
          <ul class="ag__toc-list" data-ag-toc-list role="list"></ul>
        </details>

        <div class="ag__content" data-ag-content>
          {{ article.content }}
        </div>

        <footer class="ag__foot">
          {%- if section.settings.show_share -%}
            <div class="ag__share">
              <span class="ag__share-label">Share this article</span>
              <a
                class="ag__share-btn"
                href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}"
                target="_blank"
                rel="noopener"
              >Facebook</a>
              <a
                class="ag__share-btn"
                href="https://twitter.com/intent/tweet?text={{ share_title }}&url={{ share_url }}"
                target="_blank"
                rel="noopener"
              >X</a>
              <a
                class="ag__share-btn"
                href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url }}"
                target="_blank"
                rel="noopener"
              >LinkedIn</a>
              <button type="button" class="ag__share-btn" data-ag-copy data-label="Copy link" data-done="Copied">
                Copy link
              </button>
            </div>
          {%- endif -%}

          {%- if section.settings.author_bio != blank or section.settings.author_image != blank -%}
            <div class="ag__author">
              {%- if section.settings.author_image -%}
                {{
                  section.settings.author_image
                  | image_url: width: 240
                  | image_tag:
                    loading: 'lazy',
                    width: 120,
                    height: 120,
                    alt: article.author,
                    class: 'ag__author-img'
                }}
              {%- endif -%}
              <div class="ag__author-body">
                <p class="ag__author-name">{{ article.author | escape }}</p>
                {%- if section.settings.author_bio != blank -%}
                  <p class="ag__author-bio">{{ section.settings.author_bio | escape }}</p>
                {%- endif -%}
                {%- if section.settings.author_link != blank -%}
                  <a class="ag__author-link" href="{{ section.settings.author_link }}" target="_blank" rel="noopener">
                    {{- section.settings.author_link_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </footer>
      </div>

      <aside class="ag__aside">
        <div class="ag__sticky">
          <nav class="ag__toc ag__toc--aside" data-ag-toc aria-label="{{ section.settings.toc_title | escape }}">
            <p class="ag__toc-title">{{ section.settings.toc_title | escape }}</p>
            <div class="ag__toc-scroll" data-ag-toc-scroll>
              <ul class="ag__toc-list" data-ag-toc-list role="list"></ul>
            </div>
          </nav>

          {%- if section.settings.show_newsletter -%}
            <div class="ag__news">
              <p class="ag__news-title">{{ section.settings.newsletter_heading | escape }}</p>
              {%- if section.settings.newsletter_text != blank -%}
                <p class="ag__news-text">{{ section.settings.newsletter_text | escape }}</p>
              {%- endif -%}

              {%- form 'customer', id: 'ArticleNewsletter', class: 'ag__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="ag__form-ok" role="status">Thanks for subscribing!</p>
                {%- else -%}
                  <label class="visually-hidden" for="ArticleNewsletter-email">Email</label>
                  <input
                    id="ArticleNewsletter-email"
                    class="ag__input"
                    type="email"
                    name="contact[email]"
                    autocomplete="email"
                    required
                    placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                  >
                  <button type="submit" name="commit" class="ag__btn">
                    {{- section.settings.newsletter_button | escape -}}
                  </button>
                  {%- if form.errors -%}
                    <p class="ag__form-err" role="alert">{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</article-guide>

<script src="{{ 'article-guide.js' | asset_url }}" defer="defer"></script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
    "headline": {{ article.title | json }},
    {%- if article.excerpt != blank -%}
      "description": {{ article.excerpt | strip_html | json }},
    {%- endif -%}
    {%- if article.image -%}
      "image": [ {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }} ],
    {%- endif -%}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateModified": {{ updated | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
  }
</script>

{% stylesheet %}
  article-guide {
    display: block;
  }
  .ag {
    padding: var(--ag-pt, 36px) 0 var(--ag-pb, 60px);
  }

  /* 顶部大图 */
  .ag__hero {
    margin-bottom: 3.2rem;
    overflow: hidden;
    border-radius: 2rem;
    aspect-ratio: var(--ag-ratio-m, 3 / 2);
    background: rgba(var(--color-foreground), 0.06);
  }
  .ag__hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 布局：手机单列，桌面左文右栏 */
  .ag__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4rem;
  }

  /* 标题区 */
  .ag__title {
    margin: 0 0 1.6rem;
    font-size: clamp(3rem, 4vw, 5.2rem);
    font-weight: 800;
    line-height: 1.08;
    overflow-wrap: anywhere;
  }
  .ag__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin: 0 0 3rem;
    color: rgba(var(--color-foreground), 0.6);
    font-size: 1.4rem;
  }
  .ag__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
  }

  /* 移动端目录（折叠） */
  .ag__toc-m {
    margin: 0 0 3rem;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: 1.4rem;
  }
  .ag__toc-m summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 1.6rem 2rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }
  .ag__toc-m summary::-webkit-details-marker {
    display: none;
  }
  .ag__toc-m summary::after {
    content: '+';
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1;
  }
  .ag__toc-m[open] summary::after {
    content: '\2212';
  }
  .ag__toc-m .ag__toc-list {
    margin: 0 2rem 2rem;
  }

  /* 目录列表（桌面和移动共用） */
  .ag__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid rgba(var(--color-foreground), 0.1);
  }
  .ag__toc-list a {
    display: block;
    margin-left: -2px;
    padding: 0.8rem 0 0.8rem 1.6rem;
    border-left: 2px solid transparent;
    color: rgba(var(--color-foreground), 0.65);
    font-size: 1.4rem;
    line-height: 1.4;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ag__toc-list a:hover {
    color: rgb(var(--color-foreground));
  }
  .ag__toc-list a.is-active {
    border-left-color: rgb(var(--color-foreground));
    color: rgb(var(--color-foreground));
    font-weight: 700;
  }

  .ag--no-toc [data-ag-toc] {
    display: none !important;
  }

  /* 正文排版 */
  .ag__content {
    font-size: 1.7rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .ag__content > :first-child {
    margin-top: 0;
  }
  .ag__content p {
    margin: 0 0 1.8rem;
  }
  .ag__content h2,
  .ag__content h3,
  .ag__content h4 {
    scroll-margin-top: calc(var(--header-height, 0px) + 2rem);
    font-family: var(--font-heading-family);
    line-height: 1.2;
  }
  .ag__content h2 {
    margin: 4.8rem 0 1.6rem;
    font-size: clamp(2.4rem, 2.4vw, 3.4rem);
    font-weight: 800;
  }
  .ag__content h3 {
    margin: 3.2rem 0 1.2rem;
    font-size: clamp(2rem, 1.8vw, 2.4rem);
    font-weight: 700;
  }
  .ag__content h4 {
    margin: 2.4rem 0 1rem;
    font-size: 1.8rem;
    font-weight: 700;
  }
  .ag__content ul,
  .ag__content ol {
    margin: 0 0 2rem;
    padding-left: 2.4rem;
  }
  .ag__content li {
    margin-bottom: 0.8rem;
  }
  .ag__content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }
  .ag__content img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2.8rem 0;
    border-radius: 1.4rem;
  }
  .ag__content blockquote {
    margin: 2.8rem 0;
    padding: 0.4rem 0 0.4rem 2rem;
    border-left: 3px solid rgb(var(--color-foreground));
    font-size: 1.9rem;
  }
  .ag__table {
    margin: 2.8rem 0;
    overflow-x: auto;
  }
  .ag__table table {
    width: 100%;
    min-width: 52rem;
    border-collapse: collapse;
    font-size: 1.5rem;
    line-height: 1.5;
  }
  .ag__table th,
  .ag__table td {
    padding: 1.2rem 1.4rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
    text-align: left;
    vertical-align: top;
  }
  .ag__table th {
    background: rgba(var(--color-foreground), 0.05);
    font-weight: 700;
  }

  /* 文末：分享 + 作者 */
  .ag__foot {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .ag__share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .ag__share-label {
    margin-right: 0.6rem;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .ag__share-btn {
    padding: 0.8rem 1.6rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 1.3rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ag__share-btn:hover {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
  .ag__author {
    display: flex;
    gap: 2rem;
    padding: 2.4rem;
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.04);
  }
  .ag__author-img {
    flex: none;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .ag__author-name {
    margin: 0 0 0.6rem;
    font-size: 1.7rem;
    font-weight: 700;
  }
  .ag__author-bio {
    margin: 0 0 1rem;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.5rem;
    line-height: 1.6;
  }
  .ag__author-link {
    font-size: 1.4rem;
    font-weight: 700;
  }

  /* 右栏：目录 + 邮箱订阅 */
  .ag__toc--aside {
    display: none;
  }
  .ag__toc-title {
    margin: 0 0 1.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .ag__toc-scroll {
    position: relative;
    max-height: min(42vh, 36rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .ag__news {
    margin-top: 3rem;
    padding: 2.4rem;
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.05);
  }
  .ag__news-title {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .ag__news-text {
    margin: 0 0 1.6rem;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.4rem;
    line-height: 1.5;
  }
  .ag__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ag__input {
    box-sizing: border-box;
    width: 100%;
    padding: 1.3rem 1.5rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 1rem;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 1.5rem;
  }
  .ag__input:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }
  .ag__btn {
    padding: 1.4rem 1.6rem;
    border: 0;
    border-radius: 1rem;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-family: inherit;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .ag__btn:hover {
    opacity: 0.85;
  }
  .ag__form-ok {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .ag__form-err {
    margin: 0;
    color: #c0392b;
    font-size: 1.3rem;
  }

  @media (min-width: 750px) {
    .ag__hero {
      aspect-ratio: var(--ag-ratio, 21 / 9);
      border-radius: 2.4rem;
    }
  }

  @media (min-width: 990px) {
    .ag__layout {
      grid-template-columns: minmax(0, 1fr) var(--ag-aside-w, 340px);
      gap: 6rem;
    }
    .ag__toc-m {
      display: none;
    }
    .ag__toc--aside {
      display: block;
    }
    /* aside 本身撑满整行高度，里面的 sticky 才有可以移动的空间 */
    .ag__sticky {
      position: sticky;
      top: calc(var(--header-height, 0px) + 2rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "文章详情（目录版）",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "顶部图片" },
    { "type": "checkbox", "id": "show_image", "label": "显示文章封面图", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "桌面端图片比例",
      "default": "21 / 9",
      "options": [
        { "value": "21 / 9", "label": "21:9" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "auto", "label": "原图比例" }
      ]
    },

    { "type": "header", "content": "目录" },
    { "type": "text", "id": "toc_title", "label": "目录标题", "default": "In this article" },
    {
      "type": "range",
      "id": "toc_min",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "至少有几个 H2 才显示目录",
      "default": 2
    },

    { "type": "header", "content": "邮箱订阅" },
    { "type": "checkbox", "id": "show_newsletter", "label": "显示邮箱订阅", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "标题", "default": "Subscribe to our newsletter" },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "说明文字",
      "default": "New guides and exclusive offers, straight to your inbox."
    },
    { "type": "text", "id": "newsletter_placeholder", "label": "输入框提示", "default": "Enter your email" },
    { "type": "text", "id": "newsletter_button", "label": "按钮文字", "default": "Subscribe" },

    { "type": "header", "content": "分享与作者" },
    { "type": "checkbox", "id": "show_share", "label": "显示分享按钮", "default": true },
    { "type": "image_picker", "id": "author_image", "label": "作者头像" },
    { "type": "textarea", "id": "author_bio", "label": "作者简介" },
    { "type": "url", "id": "author_link", "label": "作者主页链接" },
    { "type": "text", "id": "author_link_label", "label": "作者链接文字", "default": "LinkedIn" },

    { "type": "header", "content": "布局" },
    {
      "type": "range",
      "id": "aside_width",
      "min": 280,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "右栏宽度（桌面端）",
      "default": 340
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 60
    }
  ]
}
{% endschema %}