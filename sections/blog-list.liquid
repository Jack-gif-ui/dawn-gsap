{%- paginate blog.articles by section.settings.per_page -%}
  <blog-list
    class="bl{% unless section.settings.show_tag %} bl--no-tag{% endunless %}{% unless section.settings.show_read_time %} bl--no-read{% endunless %}"
    data-blog-url="{{ blog.url }}"
    data-search-url="{{ routes.predictive_search_url }}"
    data-results-section="blog-search-results"
    style="
      --bl-cols: {{ section.settings.columns }};
      --bl-ratio: {{ section.settings.image_ratio }};
      --bl-radius: {{ section.settings.card_radius }}px;
      --bl-tag: {{ section.settings.tag_color }};
      --bl-pt: {{ section.settings.padding_top }}px;
      --bl-pb: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width">
      <header class="bl__hero">
        <h1
          class="bl__title bl__title--{{ section.settings.heading_size }}"
          style="--bl-h-scale: {{ section.settings.heading_scale | divided_by: 100.0 }};"
        >
          {{- section.settings.heading | default: blog.title | escape -}}
        </h1>
        {%- if section.settings.subheading != blank -%}
          <p class="bl__sub bl__sub--{{ section.settings.subheading_size }}">
            {{- section.settings.subheading | escape -}}
          </p>
        {%- endif -%}
      </header>

      <div class="bl__list" id="BlogList">
        <div class="bl__bar">
          <h2 class="bl__list-title">{{ section.settings.list_heading | escape }}</h2>

          {%- if section.settings.show_search -%}
            <form class="bl__search" role="search" action="{{ routes.search_url }}" method="get" data-bl-form>
              <input type="hidden" name="type" value="article">
              <label class="visually-hidden" for="BlogSearch-{{ section.id }}">Search blog posts</label>
              <input
                id="BlogSearch-{{ section.id }}"
                class="bl__search-input"
                type="search"
                name="q"
                autocomplete="off"
                placeholder="{{ section.settings.search_placeholder | escape }}"
                data-bl-input
              >
              <button type="submit" class="bl__search-btn" aria-label="Search">
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7"/>
                  <path d="M20 20l-3.5-3.5"/>
                </svg>
              </button>
            </form>
          {%- endif -%}
        </div>

        <p class="bl__status" role="status" aria-live="polite" data-bl-status></p>
        <div class="bl__grid" data-bl-results hidden></div>

        <div data-bl-default>
          {%- if blog.articles.size > 0 -%}
            <div class="bl__grid">
              {%- for article in blog.articles -%}
                {%- render 'blog-card', article: article -%}
              {%- endfor -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <nav class="bl__pagination" role="navigation" aria-label="Pagination">
                <ul role="list">
                  <li>
                    {%- if paginate.previous -%}
                      <a
                        class="bl__page bl__page--arrow"
                        href="{{ paginate.previous.url | append: '#BlogList' }}"
                        aria-label="Previous page"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path d="M15 5l-7 7 7 7"/>
                        </svg>
                      </a>
                    {%- else -%}
                      <span class="bl__page bl__page--arrow is-disabled" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M15 5l-7 7 7 7"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </li>

                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a
                          class="bl__page"
                          href="{{ part.url | append: '#BlogList' }}"
                          aria-label="Page {{ part.title }}"
                        >
                          {{- part.title -}}
                        </a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span class="bl__page is-current" aria-current="page">{{ part.title }}</span>
                      {%- else -%}
                        <span class="bl__page bl__page--gap">…</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}

                  <li>
                    {%- if paginate.next -%}
                      <a
                        class="bl__page bl__page--arrow"
                        href="{{ paginate.next.url | append: '#BlogList' }}"
                        aria-label="Next page"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path d="M9 5l7 7-7 7"/>
                        </svg>
                      </a>
                    {%- else -%}
                      <span class="bl__page bl__page--arrow is-disabled" aria-hidden="true">
                        <svg
                          viewBox="0 0 24 24"
                          width="20"
                          height="20"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path d="M9 5l7 7-7 7"/>
                        </svg>
                      </span>
                    {%- endif -%}
                  </li>
                </ul>
              </nav>
            {%- endif -%}
          {%- else -%}
            <p class="bl__empty">No articles yet.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </blog-list>
{%- endpaginate -%}

<script src="{{ 'blog-list.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  blog-list {
    display: block;
  }
  .bl {
    padding: var(--bl-pt, 40px) 0 var(--bl-pb, 80px);
  }
  .bl [hidden] {
    display: none !important;
  }

  /* 顶部标题 */
  .bl__hero {
    margin-bottom: clamp(4rem, 7vw, 9rem);
    text-align: center;
  }
  /* 标题：四档字号，再乘微调滑块和主题的标题缩放 */
  .bl__title--xl {
    --bl-h-size: clamp(3.2rem, 5.4vw, 8rem);
  }
  .bl__title--l {
    --bl-h-size: clamp(2.8rem, 4vw, 6rem);
  }
  .bl__title--m {
    --bl-h-size: clamp(2.4rem, 3vw, 4.4rem);
  }
  .bl__title--s {
    --bl-h-size: clamp(2rem, 2.2vw, 3.2rem);
  }
  .bl__title {
    margin: 0;
    font-size: calc(var(--bl-h-size, 5.4vw) * var(--bl-h-scale, 1) * var(--font-heading-scale, 1));
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  /* 描述：三档字号，乘主题的正文缩放 */
  .bl__sub--l {
    --bl-s-size: clamp(1.8rem, 1.8vw, 2.6rem);
  }
  .bl__sub--m {
    --bl-s-size: clamp(1.6rem, 1.5vw, 2.2rem);
  }
  .bl__sub--s {
    --bl-s-size: clamp(1.4rem, 1.2vw, 1.8rem);
  }
  .bl__sub {
    max-width: 72rem;
    margin: 1.6rem auto 0;
    font-size: calc(var(--bl-s-size, 1.6rem) * var(--font-body-scale, 1));
    line-height: 1.5;
  }
  /* "ALL BLOGS" + 搜索：手机上搜索在上，桌面端同一行 */
  .bl__list {
    scroll-margin-top: calc(var(--header-height, 0px) + 2rem);
  }
  .bl__bar {
    display: flex;
    flex-direction: column-reverse;
    gap: 2.4rem;
    margin-bottom: 3.2rem;
  }
  .bl__list-title {
    margin: 0;
    font-size: clamp(2.8rem, 4vw, 6rem);
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }
  .bl__search {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 0.4rem;
    background: rgba(var(--color-foreground), 0.04);
  }
  .bl__search:focus-within {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }
  .bl__search-input {
    flex: 1;
    min-width: 0;
    padding: 1.8rem 6rem 1.8rem 2.4rem;
    border: 0;
    outline: none;
    background: transparent;
    color: rgb(var(--color-foreground));
    font: inherit;
    font-size: 1.7rem;
    font-weight: 600;
  }
  .bl__search-input::placeholder {
    color: rgba(var(--color-foreground), 0.5);
  }
  .bl__search-btn {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 5.6rem;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  .bl__status {
    margin: 0 0 2.4rem;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.5rem;
  }
  .bl__status:empty {
    display: none;
  }
  .bl__clear {
    margin-left: 1.2rem;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(var(--color-foreground));
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
    cursor: pointer;
  }
  .bl.is-loading [data-bl-results],
  .bl.is-loading [data-bl-default] {
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  /* 卡片网格 */
  .bl__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4.8rem 2.4rem;
  }
  .bl__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .bl__media {
    aspect-ratio: var(--bl-ratio, 16 / 9);
    overflow: hidden;
    border-radius: var(--bl-radius, 6px);
    background: rgba(var(--color-foreground), 0.08);
  }
  .bl__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bl__card:hover .bl__img {
    transform: scale(1.04);
  }
  .bl__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2.4rem;
  }
  .bl__tag {
    margin: 0;
    min-height: 1.5em;
    overflow: hidden;
    color: var(--bl-tag, #2b8fd4);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    line-height: 1.5;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .bl__tag--empty {
    visibility: hidden;
  }
  .bl--no-tag .bl__tag {
    display: none;
  }
  .bl__card-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 1.7vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    text-transform: uppercase;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  /* 整张卡片可点：标题链接撑满卡片 */
  .bl__link {
    color: inherit;
    text-decoration: none;
  }
  .bl__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .bl__link:focus-visible::after {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 2px;
  }
  .bl__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: auto 0 0;
    padding-top: 2rem;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .bl__sep {
    width: 2px;
    height: 1.1em;
    background: currentColor;
  }
  .bl--no-read .bl__sep,
  .bl--no-read .bl__read {
    display: none;
  }
  .bl__empty {
    padding: 4rem 0;
    text-align: center;
  }

  /* 分页 */
  .bl__pagination {
    margin-top: 6rem;
  }
  .bl__pagination ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bl__page {
    display: grid;
    place-items: center;
    min-width: 5rem;
    height: 5rem;
    padding: 0 0.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: inherit;
    font-size: 1.6rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  a.bl__page:hover {
    border-color: rgb(var(--color-foreground));
  }
  .bl__page.is-current {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
  .bl__page--arrow {
    border-color: rgba(var(--color-foreground), 0.25);
  }
  .bl__page.is-disabled {
    opacity: 0.35;
  }

  @media (min-width: 750px) {
    .bl__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .bl__bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 4rem;
    }
    .bl__search {
      width: min(46rem, 42%);
    }
    .bl__grid {
      grid-template-columns: repeat(var(--bl-cols, 3), minmax(0, 1fr));
      gap: 5.6rem 3.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "博客列表",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "顶部" },
        { "type": "header", "content": "顶部标题" },
    {
      "type": "text",
      "id": "heading",
      "label": "页面标题",
      "info": "留空则使用博客名称",
      "default": "Moissanite & Jewelry Blog"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题字号",
      "default": "xl",
      "options": [
        { "value": "xl", "label": "特大" },
        { "value": "l", "label": "大" },
        { "value": "m", "label": "中" },
        { "value": "s", "label": "小" }
      ]
    },
    {
      "type": "range",
      "id": "heading_scale",
      "min": 60,
      "max": 140,
      "step": 5,
      "unit": "%",
      "label": "标题字号微调",
      "info": "在上面选定的档位基础上整体放大或缩小",
      "default": 100
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "描述",
      "default": "Need a quick answer to one of our top questions? We got you."
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "描述字号",
      "default": "m",
      "options": [
        { "value": "l", "label": "大" },
        { "value": "m", "label": "中" },
        { "value": "s", "label": "小" }
      ]
    },

    { "type": "header", "content": "列表" },
    { "type": "text", "id": "list_heading", "label": "列表标题", "default": "All blogs" },
    {
      "type": "range",
      "id": "per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "每页文章数",
      "default": 9
    },
    {
      "type": "select",
      "id": "columns",
      "label": "桌面端列数",
      "default": "3",
      "options": [
        { "value": "2", "label": "2 列" },
        { "value": "3", "label": "3 列" },
        { "value": "4", "label": "4 列" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "封面图比例",
      "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "1:1" }
      ]
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "封面图圆角",
      "default": 6
    },
    { "type": "checkbox", "id": "show_tag", "label": "显示标签（文章第一个标签）", "default": true },
    { "type": "checkbox", "id": "show_read_time", "label": "显示阅读时长", "default": true },
    { "type": "color", "id": "tag_color", "label": "标签颜色", "default": "#2b8fd4" },

    { "type": "header", "content": "搜索" },
    { "type": "checkbox", "id": "show_search", "label": "显示搜索框", "default": true },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "搜索框提示",
      "default": "Search blog posts by title..."
    },

    { "type": "header", "content": "间距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "上边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "下边距",
      "default": 80
    }
  ]
}
{% endschema %}
