{%- if section.blocks.size == 0 -%}
  {%- if request.design_mode -%}
    <p class="ms-empty page-width">Add people to the marquee strip in the section settings.</p>
  {%- endif -%}
{%- else -%}
  <marquee-strip
    class="ms{% if section.settings.pause_on_hover %} ms--pause{% endif %}{% if section.settings.fade_edges %} ms--fade{% endif %}{% if section.settings.separator %} ms--sep{% endif %}{% if section.settings.direction == 'right' %} ms--right{% endif %}{% unless section.settings.uppercase %} ms--normalcase{% endunless %}"
    data-speed="{{ section.settings.speed }}"
    style="
      --ms-bg: {{ section.settings.bg_color }};
      --ms-text: {{ section.settings.text_color }};
      --ms-line: {{ section.settings.line_color }};
      --ms-badge: {{ section.settings.badge_color }};
      --ms-gap: {{ section.settings.gap }}px;
      --ms-avatar: {{ section.settings.avatar_size }}px;
      --ms-avatar-m: {{ section.settings.avatar_size_mobile }}px;
      --ms-name: {{ section.settings.name_size }}px;
      --ms-name-m: {{ section.settings.name_size_mobile }}px;
      --ms-pt: {{ section.settings.padding_top }}px;
      --ms-pb: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="ms__wrap">
      <div class="ms__track">
        {%- for copy in (1..2) -%}
          <ul
            class="ms__group"
            role="list"
            {% if copy == 1 %}
              data-ms-group
            {% else %}
              aria-hidden="true" inert
            {% endif %}
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign name = block.settings.name
                assign initial = name | strip | slice: 0 | upcase
                assign link = block.settings.link
                assign tag = 'span'
                if link != blank
                  assign tag = 'a'
                endif
              -%}
              <li class="ms__item" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <{{ tag }}
                  class="ms__inner"
                  {% if link != blank %}
                    href="{{ link }}"
                  {% endif %}
                >
                  {%- if section.settings.show_avatar -%}
                    <span class="ms__avatar">
                      {%- if block.settings.image -%}
                        {{
                          block.settings.image
                          | image_url: width: 160
                          | image_tag:
                            loading: 'lazy',
                            width: 80,
                            height: 80,
                            sizes: '80px',
                            alt: '',
                            class: 'ms__img'
                        }}
                      {%- else -%}
                        <span class="ms__initial" aria-hidden="true">{{ initial }}</span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  <span class="ms__name">{{ name | escape }}</span>

                  {%- if section.settings.show_badge and block.settings.verified -%}
                    <span class="ms__badge" role="img" aria-label="Verified">
                      <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
                        <g fill="currentColor">
                          <rect x="2.75" y="2.75" width="14.5" height="14.5" rx="4"/>
                          <rect x="2.75" y="2.75" width="14.5" height="14.5" rx="4" transform="rotate(45 10 10)"/>
                        </g>
                        <path d="M6.2 10.4l2.5 2.5 5.1-5.3" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  {%- endif -%}
                </{{ tag }}>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  </marquee-strip>

  <script src="{{ 'marquee-strip.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% stylesheet %}
  marquee-strip {
    display: block;
  }
  .ms {
    padding: var(--ms-pt, 0) 0 var(--ms-pb, 30px);
    background: var(--ms-bg, #fff);
    color: var(--ms-text, #000);
    overflow: hidden;
  }
  .ms-empty {
    padding: 2rem 0;
    text-align: center;
    opacity: 0.6;
  }

  .ms__wrap {
    overflow: hidden;
  }
  .ms--fade .ms__wrap {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent 100%);
  }
  .ms__track {
    display: flex;
    width: max-content;
  }

  /* 两份内容各自向左位移自己的整个宽度，循环时无缝衔接 */
  .ms__group {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-around;
    gap: var(--ms-gap, 12px);
    min-width: 100vw;
    margin: 0;
    padding: 0 var(--ms-gap, 12px) 0 0;
    list-style: none;
    animation: ms-scroll var(--ms-duration, 40s) linear infinite;
    will-change: transform;
  }
  .ms--right .ms__group {
    animation-direction: reverse;
  }
  .ms--pause .ms__wrap:hover .ms__group,
  .ms.is-offscreen .ms__group {
    animation-play-state: paused;
  }
  @keyframes ms-scroll {
    to {
      transform: translateX(-100%);
    }
  }

  .ms__item {
    flex: none;
  }
  .ms--sep .ms__item {
    border-right: 1px solid var(--ms-line, #e3e3e3);
  }
  .ms__inner {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px 3px 4px;
    color: inherit;
    text-decoration: none;
  }
  a.ms__inner:hover .ms__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ms__avatar {
    flex: none;
    box-sizing: border-box;
    width: var(--ms-avatar-m, 28px);
    height: var(--ms-avatar-m, 28px);
    padding: 2px;
    border: 2px solid var(--ms-line, #e3e3e3);
    border-radius: 50%;
  }
  .ms__img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .ms__initial {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--ms-line, #e3e3e3);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .ms__name {
    font-size: var(--ms-name-m, 11px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ms--normalcase .ms__name {
    text-transform: none;
  }
  .ms__badge {
    display: inline-flex;
    flex: none;
    color: var(--ms-badge, #5395e9);
  }

  @media (min-width: 750px) {
    .ms__avatar {
      width: var(--ms-avatar, 30px);
      height: var(--ms-avatar, 30px);
    }
    .ms__name {
      font-size: var(--ms-name, 14px);
    }
  }

  /* 减少动态效果：不播放，改成可以手动横向滑动，并隐藏复制出来的那份 */
  @media (prefers-reduced-motion: reduce) {
    .ms__wrap {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .ms__group {
      min-width: 0;
      animation: none;
    }
    .ms__group[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "跑马灯条",
  "tag": "section",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "内容显示" },
    { "type": "checkbox", "id": "show_avatar", "label": "显示头像", "info": "关闭后就是纯文字跑马灯", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "显示认证徽章", "default": true },
    { "type": "checkbox", "id": "uppercase", "label": "名字全部大写", "default": true },
    { "type": "checkbox", "id": "separator", "label": "项目之间显示分隔线", "default": true },

    { "type": "header", "content": "滚动" },
    {
      "type": "range",
      "id": "speed",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "滚动速度（每秒像素）",
      "default": 50
    },
    {
      "type": "select",
      "id": "direction",
      "label": "滚动方向",
      "default": "left",
      "options": [
        { "value": "left", "label": "向左" },
        { "value": "right", "label": "向右" }
      ]
    },
    { "type": "checkbox", "id": "pause_on_hover", "label": "鼠标悬停时暂停", "default": true },
    { "type": "checkbox", "id": "fade_edges", "label": "两端渐隐", "default": true },

    { "type": "header", "content": "尺寸" },
    {
      "type": "range",
      "id": "avatar_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "头像大小（桌面端）",
      "default": 30
    },
    {
      "type": "range",
      "id": "avatar_size_mobile",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "头像大小（移动端）",
      "default": 28
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "名字字号（桌面端）",
      "default": 14
    },
    {
      "type": "range",
      "id": "name_size_mobile",
      "min": 9,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "名字字号（移动端）",
      "default": 11
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "项目间距",
      "default": 12
    },

    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "bg_color", "label": "背景色", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#000000" },
    { "type": "color", "id": "line_color", "label": "分隔线和头像描边", "default": "#e3e3e3" },
    { "type": "color", "id": "badge_color", "label": "认证徽章颜色", "default": "#5395e9" },

    { "type": "header", "content": "间距" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "上边距",
      "info": "要紧贴上方的 Hero 图，就保持 0",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "下边距",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "项目",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "头像", "info": "不选则显示名字首字母" },
        { "type": "text", "id": "name", "label": "名字或文字", "default": "Name" },
        { "type": "checkbox", "id": "verified", "label": "显示认证徽章", "default": true },
        { "type": "url", "id": "link", "label": "链接（可选）" }
      ]
    }
  ],
  "presets": [
    {
      "name": "跑马灯条",
      "blocks": [
        { "type": "person", "settings": { "name": "Name One" } },
        { "type": "person", "settings": { "name": "Name Two" } },
        { "type": "person", "settings": { "name": "Name Three" } },
        { "type": "person", "settings": { "name": "Name Four" } },
        { "type": "person", "settings": { "name": "Name Five" } },
        { "type": "person", "settings": { "name": "Name Six" } }
      ]
    }
  ]
}
{% endschema %}