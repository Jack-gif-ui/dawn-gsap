{%- if section.blocks.size > 0 or request.design_mode -%}
  <celebrity-carousel
    class="celebrity-carousel"
    data-autoplay="{{ section.settings.people_autoplay }}"
    data-speed="{{ section.settings.people_speed }}"
    style="--cc-radius: {{ section.settings.card_radius }}px; --cc-heading-align: {{ section.settings.heading_align }};"
  >
    {%- if section.settings.heading != blank -%}
      <h2 id="CelebrityHeading-{{ section.id }}" class="celebrity-carousel__heading" data-sd-item>
        {{- section.settings.heading | escape -}}
      </h2>
    {%- endif -%}

    <div
      class="celebrity-carousel__track"
      data-celebrity-track
      data-sd-item
      role="region"
      {% if section.settings.heading != blank %}
        aria-labelledby="CelebrityHeading-{{ section.id }}"
      {% else %}
        aria-label="Celebrity carousel"
      {% endif %}
      tabindex="0"
      dir="ltr"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign person = block.settings
          assign card_tag = 'div'
          if person.link != blank
            assign card_tag = 'a'
          endif
        -%}

        <{{ card_tag }}
          class="celebrity-carousel__card"
          {% if person.link != blank %}
            href="{{ person.link | escape }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if person.image != blank -%}
            {{
              person.image
              | image_url: width: 840
              | image_tag:
                loading: 'lazy',
                widths: '180, 240, 360, 480, 640, 840',
                sizes: '(min-width: 750px) max(14vw, 210px), 46vw',
                alt: person.image.alt
            }}
          {%- elsif request.design_mode -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if person.name != blank -%}
            <span class="celebrity-carousel__name" dir="auto">
              <span>{{ person.name | escape }}</span>
              {%- if person.show_badge -%}
                <svg class="celebrity-carousel__badge" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <circle class="celebrity-carousel__badge-circle" cx="12" cy="12" r="11" fill="currentColor"/>
                  <g class="celebrity-carousel__badge-seal" fill="currentColor">
                    <rect x="3.3" y="3.3" width="17.4" height="17.4" rx="4.8"/>
                    <rect x="3.3" y="3.3" width="17.4" height="17.4" rx="4.8" transform="rotate(45 12 12)"/>
                  </g>
                  <path d="M7 12.6l3.3 3.3L17 9.2" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="visually-hidden">(verified)</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </{{ card_tag }}>
      {%- endfor -%}

      {%- if section.blocks.size == 0 and request.design_mode -%}
        <p class="celebrity-carousel__empty">添加「人物卡片」区块来设置图片、姓名和链接。</p>
      {%- endif -%}
    </div>
  </celebrity-carousel>
{%- endif -%}

{% schema %}
{
  "name": "名人卡片轮播",
  "enabled_on": { "templates": ["collection", "product"], "groups": ["aside"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Worn by celebrities" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "标题对齐",
      "default": "left",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ]
    },
    { "type": "checkbox", "id": "people_autoplay", "label": "自动向左循环滚动", "default": true },
    {
      "type": "range",
      "id": "people_speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "每秒滚动像素",
      "default": 50
    },
    { "type": "range", "id": "card_radius", "min": 0, "max": 24, "step": 2, "unit": "px", "label": "卡片圆角", "default": 14 }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "人物卡片",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "图片" },
        { "type": "text", "id": "name", "label": "姓名" },
        { "type": "checkbox", "id": "show_badge", "label": "显示认证徽章", "default": true },
        { "type": "url", "id": "link", "label": "链接" }
      ]
    }
  ],
  "presets": [
    { "name": "名人卡片轮播", "blocks": [{ "type": "person" }, { "type": "person" }, { "type": "person" }] }
  ]
}
{% endschema %}