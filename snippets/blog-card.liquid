{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200.0 | ceil | at_least: 1
  assign img_alt = article.image.alt | default: article.title
-%}

<article class="bl__card" data-bl-card data-url="{{ article.url }}">
  <div class="bl__media">
    {%- if article.image -%}
      {{
        article.image
        | image_url: width: 1000
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000',
          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
          alt: img_alt,
          class: 'bl__img'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'bl__img placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="bl__body">
    {%- if article.tags.size > 0 -%}
      <p class="bl__tag">{{ article.tags.first | escape }}</p>
    {%- else -%}
      <p class="bl__tag bl__tag--empty" aria-hidden="true">&nbsp;</p>
    {%- endif -%}

    <h3 class="bl__card-title">
      <a class="bl__link" href="{{ article.url }}">{{ article.title | escape }}</a>
    </h3>

    <p class="bl__meta">
      {{ article.published_at | time_tag: '%b %d, %Y' }}
      <span class="bl__sep" aria-hidden="true"></span>
      <span class="bl__read">{{ minutes }} min read</span>
    </p>
  </div>
</article>